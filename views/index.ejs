<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notes</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-950 text-zinc-100">
    <div class="main flex min-h-screen w-full items-center justify-center px-6 py-12">
        <div class="form w-full max-w-xl">
            <div class="mb-8">
                <p class="mb-2 text-sm font-medium uppercase tracking-[0.2em] text-indigo-400">Your workspace</p>
                <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Create a new note</h1>
                <p class="mt-3 text-zinc-400">Capture an idea, task, or reminder before it slips away.</p>
            </div>
            <form action="/create" method="POST" class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-6 shadow-2xl shadow-black/20 sm:p-8">
                <input type="text" placeholder="Title goes here" name="title"
                    class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-4 py-3 text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                <textarea placeholder="Write your task details here" rows="6" name="details"
                    class="mt-2 w-full resize-y rounded-xl border border-zinc-700 bg-zinc-950 px-4 py-3 text-white outline-none transition placeholder:text-zinc-500 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20"></textarea>
                <input type="submit" value="Create Task"
                    class="mt-2 w-full cursor-pointer rounded-xl bg-indigo-500 px-4 py-3 font-semibold text-white transition hover:bg-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 focus:ring-offset-zinc-900">
            </form>
        </div>
    </div>
    <div class="mx-auto w-full max-w-xl px-6 pb-12">
        <% if (files.length > 0) { %>
            <div class="space-y-3">
                <% files.forEach(function (val) { %>
                    <div class="flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-900/80 px-5 py-4">
                        <h2 class="truncate pr-4 font-medium text-zinc-200"><%= val %></h2>
                        <a class="shrink-0 text-sm font-medium text-indigo-400 transition hover:text-indigo-300" href="/file/<%=val%>">Read more</a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="rounded-xl border border-dashed border-zinc-800 px-5 py-6 text-center text-zinc-500">No notes yet.</p>
        <% } %>
    </div>
</body>
<script src="/javascript/script.js"></script>

</html>