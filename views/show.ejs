<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notes</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-zinc-950 text-zinc-100">
    <main class="mx-auto w-full max-w-3xl px-6 py-12 sm:py-16">
        <a href="/" class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-zinc-400 transition hover:text-indigo-400">
            <span aria-hidden="true">&larr;</span>
            Back to notes
        </a>
        <article class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-6 shadow-2xl shadow-black/20 sm:p-8">
            <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-indigo-400">Note</p>
            <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"><%= fn.replace(/\.txt$/, '').replace(/([a-z])([A-Z])/g, '$1 $2') %></h1>
            <div class="my-6 h-px bg-zinc-800"></div>
            <p class="whitespace-pre-wrap leading-7 text-zinc-300"><%= fd %></p>
        </article>
    </main>
</body>
<script src="/javascript/script.js"></script>

</html>